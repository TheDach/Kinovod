<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh_layout_rooms"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/white">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tv_label_rooms"
            style="@style/MainLabels"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="18dp"
            android:gravity="center"
            android:orientation="horizontal">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_create_rooms"
                style="@style/ButtonRoomsStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/button_background_outline"
                android:backgroundTint="@color/purple_500"
                android:text="@string/btn_create"
                android:textColor="@color/white"

                app:backgroundTint="@color/purple_500"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_plus_svg"
                app:iconGravity="textStart"
                app:iconTint="@color/white"
                app:strokeColor="@color/white"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_connect_rooms"
                style="@style/ButtonRoomsStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1.5"

                android:background="@drawable/button_background_outline"
                android:text="@string/btn_connect_rooms"
                android:textColor="@color/black"

                app:backgroundTint="@color/white"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_link_svg"
                app:iconGravity="textStart"
                app:iconTint="@color/black"
                app:strokeColor="@color/black"
                app:strokeWidth="1dp" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_rooms"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingVertical="20dp"

            tools:listitem="@layout/room_item"/>

        <ProgressBar
            android:id="@+id/progressBar_rooms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </LinearLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>