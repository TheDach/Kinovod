<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:maxWidth="390dp"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Заголовок с кнопкой назад -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_back_new_room"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/description_comeback"
                android:src="@drawable/ic_left_arrow_svg" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/label_new_room"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Название комнаты -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/label_name_room"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edit_text_room_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/background_edittext_rounded_new_room"
                android:hint="@string/hint_example_new_room"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:textColor="@color/black"
                android:textColorHint="@color/gray_600"
                android:textSize="16sp"

                tools:text="Фантастика 2025" />
        </LinearLayout>

        <!-- Участники -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/label_player"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    app:chipSpacing="8dp"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_add_friends"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chip_add_friends"
                        android:textColor="@color/text_rating_chips_poster"
                        android:textSize="13sp"
                        app:chipBackgroundColor="@color/bg_chip_non_choice"
                        app:chipCornerRadius="30dp"
                        app:chipMinHeight="36dp"
                        app:closeIconEnabled="false" />

                    <com.google.android.material.chip.Chip
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Анна"
                        android:textColor="@color/dark_purple_movie"
                        android:textSize="13sp"
                        app:chipBackgroundColor="@color/bg_chip_choice"
                        app:chipCornerRadius="30dp"
                        app:chipMinHeight="36dp"
                        app:closeIconEnabled="true"
                        app:closeIconSize="16dp"
                        app:closeIconTint="@color/dark_purple_movie" />

                    <com.google.android.material.chip.Chip
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Игорь"
                        android:textColor="@color/dark_purple_movie"
                        android:textSize="13sp"
                        app:chipBackgroundColor="@color/bg_chip_choice"
                        app:chipCornerRadius="30dp"
                        app:chipMinHeight="36dp"
                        app:closeIconEnabled="true"
                        app:closeIconSize="16dp"
                        app:closeIconTint="@color/dark_purple_movie" />

                    <com.google.android.material.chip.Chip
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Мария"
                        android:textColor="@color/dark_purple_movie"
                        android:textSize="13sp"
                        app:chipBackgroundColor="@color/bg_chip_choice"
                        app:chipCornerRadius="30dp"
                        app:chipMinHeight="36dp"
                        app:closeIconEnabled="true"
                        app:closeIconSize="16dp"
                        app:closeIconTint="@color/dark_purple_movie" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Тип голосования -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/label_type_vote"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupVoteType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                app:chipSpacing="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_single_vote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/chip_single_vote"
                    android:textColor="@color/dark_purple_movie"
                    android:textSize="13sp"
                    app:chipBackgroundColor="@color/bg_chip_choice"
                    app:chipCornerRadius="30dp"
                    app:chipMinHeight="36dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_multiple_vote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/chip_multi_vote"
                    android:textColor="@color/text_rating_chips_poster"
                    android:textSize="13sp"
                    app:chipBackgroundColor="@color/bg_chip_non_choice"
                    app:chipCornerRadius="30dp"
                    app:chipMinHeight="36dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_priority_vote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/chip_priority_vote"
                    android:textColor="@color/text_rating_chips_poster"
                    android:textSize="13sp"
                    app:chipBackgroundColor="@color/bg_chip_non_choice"
                    app:chipCornerRadius="30dp"
                    app:chipMinHeight="36dp" />

            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Срок голосования (как строка меню) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_voting_period"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVotingDeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="до завтра 20:00 ⌄"
                android:textColor="@color/purple_500"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Сравнить wishlists (Switch) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_compare_wishlists"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_compare_wishlists"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/switch_thumb_selector"
                app:track="@drawable/switch_track_selector"
                app:thumbTint="@null" />
        </LinearLayout>

        <!-- Анонимное голосование (Switch) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_anonymous_vote"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_anonymous_voting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/switch_thumb_selector"
                app:track="@drawable/switch_track_selector"
                app:thumbTint="@null" />
        </LinearLayout>

        <!-- Фильтры -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/label_filters"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />


            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                app:chipSpacing="8dp">

                <!-- Чип для добавления нового фильтра -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_add_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chip_add"
                    android:textColor="@color/text_rating_chips_poster"
                    android:textSize="13sp"
                    app:chipBackgroundColor="@color/bg_chip_non_choice"
                    app:chipCornerRadius="30dp"
                    app:chipMinHeight="36dp"
                    app:closeIconEnabled="false" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Фантастика"
                    android:textColor="@color/dark_purple_movie"
                    android:textSize="13sp"
                    app:chipBackgroundColor="@color/bg_chip_choice"
                    app:chipCornerRadius="30dp"
                    app:chipMinHeight="36dp"
                    app:closeIconEnabled="true"
                    app:closeIconSize="16dp"
                    app:closeIconTint="@color/dark_purple_movie" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Боевик"
                    android:textColor="@color/dark_purple_movie"
                    android:textSize="13sp"
                    app:chipBackgroundColor="@color/bg_chip_choice"
                    app:chipCornerRadius="30dp"
                    app:chipMinHeight="36dp"
                    app:closeIconEnabled="true"
                    app:closeIconSize="16dp"
                    app:closeIconTint="@color/dark_purple_movie" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Драма"
                    android:textColor="@color/dark_purple_movie"
                    android:textSize="13sp"
                    app:chipBackgroundColor="@color/bg_chip_choice"
                    app:chipCornerRadius="30dp"
                    app:chipMinHeight="36dp"
                    app:closeIconEnabled="true"
                    app:closeIconSize="16dp"
                    app:closeIconTint="@color/dark_purple_movie" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IMDb >7"
                    android:textColor="@color/dark_purple_movie"
                    android:textSize="13sp"
                    app:chipBackgroundColor="@color/bg_chip_choice"
                    app:chipCornerRadius="30dp"
                    app:chipMinHeight="36dp"
                    app:closeIconEnabled="true"
                    app:closeIconSize="16dp"
                    app:closeIconTint="@color/dark_purple_movie" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Мультфильмы"
                    android:textColor="@color/dark_purple_movie"
                    android:textSize="13sp"
                    app:chipBackgroundColor="@color/bg_chip_choice"
                    app:chipCornerRadius="30dp"
                    app:chipMinHeight="36dp"
                    app:closeIconEnabled="true"
                    app:closeIconSize="16dp"
                    app:closeIconTint="@color/dark_purple_movie" />


            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Лимит предложенных фильмов -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_limit_movies"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMoviesLimit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 на пользователей ⌄"
                android:textColor="@color/purple_500"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_create_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:text="@string/btn_create_room"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:translationZ="0dp"

            app:backgroundTint="@color/purple_500"
            app:cornerRadius="40dp"
            app:elevation="0dp" />
    </LinearLayout>

</ScrollView>